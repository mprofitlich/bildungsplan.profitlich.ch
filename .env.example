APP_NAME="Bildungsplan Grafikerin/Grafiker EFZ"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://bildungsplan.profitlich.ch.ddev.site

APP_LOCALE=de_CH
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=de_CH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=db
DB_USERNAME=db
DB_PASSWORD=db

# Ein Login bleibt ein halbes Jahr bestehen; das Cookie läuft sonst mit dem Browser ab.
SESSION_DRIVER=database
SESSION_LIFETIME=259200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Mails gehen direkt beim Anfragen raus; auf dem Webhosting läuft kein Queue-Worker.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Lokal fängt Mailpit alle Mails ab (`ddev launch -m`). Produktion: smtp.gmail.com,
# Port 465, Schema smtps, Workspace-Konto mit App-Passwort.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="bildungsplan@profitlich.ch"
MAIL_FROM_NAME="${APP_NAME}"
